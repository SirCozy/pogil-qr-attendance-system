# ============================================================
# POGIL QR Attendance System — Environment Variables
# ============================================================
# Copy this file to .env.local and fill in real values.
# Never commit .env.local to version control.
# ============================================================

# Required — Session encryption secret for iron-session
# Must be at least 32 characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace_this_with_a_long_random_secret_at_least_32_chars

# Optional — Database URL (only needed if switching from SQLite to PostgreSQL)
# For SQLite (default), no DATABASE_URL is needed — Prisma uses the file path in schema.prisma
# DATABASE_URL="postgresql://user:password@localhost:5432/pogil_attendance"

# Optional — Node environment (set to "production" in deployed environments)
# NODE_ENV=production
