# ============================================================
# POGIL QR Attendance System — Environment Variables
# ============================================================
# Copy this file to .env.local and fill in real values.
# Never commit .env.local to version control.
# ============================================================

# Required — Runtime database URL for PostgreSQL/Supabase
# Use Supabase pooler endpoint with pgBouncer for stable production connections.
# Example: postgresql://postgres:PASSWORD@aws-0-eu-west-1.pooler.supabase.com:6543/postgres?pgbouncer=true
DATABASE_URL="postgresql://user:password@host:6543/postgres?pgbouncer=true"

# Required — Direct database URL for Prisma CLI/engine operations.
# Use the direct Supabase Postgres endpoint on port 5432.
# Example: postgresql://postgres:PASSWORD@aws-0-eu-west-1.supabase.co:5432/postgres
DIRECT_URL="postgresql://user:password@host:5432/postgres"

# Required — Session encryption secret for iron-session
# Must be at least 32 characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace_this_with_a_long_random_secret_at_least_32_chars

# Optional — Node environment (set to "production" in deployed environments)
# NODE_ENV=production
