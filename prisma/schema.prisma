datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id               Int                @id @default(autoincrement())
  name             String
  matricNo         String?            @unique
  email            String?            @unique
  password         String
  role             String
  academicSession  String?            // e.g., "2024/2025"
  securityQuestion String?
  securityAnswer   String?
  createdAt        DateTime?
  sessions         Session[]
  attendances      Attendance[]
  createdCodes     RegistrationCode[] @relation("AdminCodes")
  registrationCode RegistrationCode?  @relation("StudentCode")
}

model Session {
  id          Int          @id @default(autoincrement())
  course      String
  qrCode      String       @unique
  createdAt   DateTime     @default(now())
  lecturerId  Int
  lecturer    User         @relation(fields: [lecturerId], references: [id])
  attendances Attendance[]
}

model Attendance {
  id        Int      @id @default(autoincrement())
  studentId Int
  sessionId Int
  timestamp DateTime @default(now())
  student   User     @relation(fields: [studentId], references: [id])
  session   Session  @relation(fields: [sessionId], references: [id])

  @@unique([studentId, sessionId])
}

model RegistrationCode {
  id        Int       @id @default(autoincrement())
  code      String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  createdBy Int
  admin     User      @relation("AdminCodes", fields: [createdBy], references: [id])
  usedById  Int?      @unique
  usedBy    User?     @relation("StudentCode", fields: [usedById], references: [id])
}
